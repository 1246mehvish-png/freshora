{
    "name": "freshora",
    "version": "1.0.0",
    "private": true,
    "description": "Freshora - Multi-vendor fresh fruits and vegetables marketplace (single-link deployment)",
    "scripts": {
        "install:all": "npm install --prefix backend && npm install --prefix frontend",
        "build": "npm run build --prefix frontend",
        "start": "npm start --prefix backend",
        "dev:backend": "npm run dev --prefix backend",
        "dev:frontend": "npm run dev --prefix frontend"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cloudinary": "^1.41.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-validator": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.1",
        "multer": "^1.4.5-lts.1",
        "multer-storage-cloudinary": "^4.0.0",
        "nodemailer": "^6.9.14"
    },
    "license": "MIT"
}