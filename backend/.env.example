# ---------------------------------------------------------------------------
# Freshora backend environment variables
#
# Local dev:  copy this file to `backend/.env` and fill in real values.
# Vercel:     add these SAME names in
#             Project Settings -> Environment Variables (Production + Preview).
#             Do NOT commit real secrets.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas connection string in production)
# Atlas: allow network access from 0.0.0.0/0 (or Vercel's IPs) so the
# serverless functions can connect.
MONGODB_URI=mongodb://127.0.0.1:27017/freshora

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# Cloudinary (server-side only - never expose to the frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional: only needed if your Cloudinary account requires a signed upload
# preset. Leave blank to use signed uploads without a preset.
CLOUDINARY_UPLOAD_PRESET=

# Admin (seeded automatically on first run)
ADMIN_EMAIL=admin@freshora.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Freshora Admin

# Frontend URL(s) for CORS (comma-separated).
# In single-link deployment the frontend is served from the SAME origin as the
# API, so CORS is not required. Set this only for split deployments, e.g.
# CLIENT_URL=https://freshora.vercel.app
CLIENT_URL=http://localhost:5173
