# Backend API base URL
#
# Leave this EMPTY (or omit the file) for the single-link deployment. The
# frontend then uses the relative "/api" path, which works everywhere:
#   - Local dev:  the Vite proxy in vite.config.js forwards "/api" -> http://localhost:5000
#   - Vercel:     the rewrite in vercel.json routes "/api/*" -> the serverless function
#
# Only set this for a SPLIT deployment where the API lives on a different
# origin, e.g.:
#   VITE_API_URL=https://freshora-api.vercel.app/api
#
# Never hardcode http://localhost:5000 here - it would break production.
VITE_API_URL=
